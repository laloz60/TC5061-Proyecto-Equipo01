# Plantilla de variables de entorno. Copia este archivo a `.env` y edita los
# valores. `/.env` está en .gitignore: nunca se versiona ni se sube al repo.
#
#   cp .env.example .env

# URI de seguimiento de MLflow. Debe apuntar al servidor local levantado con
#   mlflow server --backend-store-uri sqlite:///mlflow.db --port 5000
# En bash / macOS / Linux:
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# En PowerShell:  $env:MLFLOW_TRACKING_URI = "http://127.0.0.1:5000"
# En CMD (sin espacios ni comillas):  set MLFLOW_TRACKING_URI=http://127.0.0.1:5000
