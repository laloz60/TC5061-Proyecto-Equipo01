# Exclusiones para el contexto de construcción de la imagen
.git/
.github/
.venv/
.venv-validacion/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Datos y artefactos pesados (no necesarios en la imagen)
data/
mlruns/
mlartifacts/
mlflow.db
*.db
models/*.pkl
models/*.joblib
models/*.onnx
notebooks/
reports/
references/
docs/

# Infraestructura de orquestacion y pruebas (no van dentro de la imagen)
# Nota: `docker/` NO se excluye porque ahi vive docker/mlflow.Dockerfile,
# que BuildKit debe poder resolver desde el contexto de construccion.
docker-compose.yml
tests/
scripts/
Makefile
MLproject
python_env.yaml

# Secretos y SO
.env
.env.*
!.env.example
.DS_Store
